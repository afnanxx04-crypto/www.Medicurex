{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Patient metadata including demographic details and family contacts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the patient profile."
        },
        "name": {
          "type": "string",
          "description": "Full name of the patient."
        },
        "age": {
          "type": "number",
          "description": "Age of the patient."
        },
        "gender": {
          "type": "string",
          "description": "Gender of the patient."
        },
        "diseases": {
          "type": "string",
          "description": "Primary diseases active on patient."
        },
        "caretakerName": {
          "type": "string",
          "description": "Name of the primary caretaker."
        },
        "familyPhones": {
          "type": "array",
          "description": "List of at least 4 family member phone numbers that can log in and view state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        }
      },
      "required": ["id", "name", "age", "gender", "caretakerName", "familyPhones", "createdAt"]
    },
    "LabReport": {
      "title": "LabReport",
      "description": "Lab report data containing vitals, sugar levels, blood pressure, temperature, and doctor recommendations.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID for the lab report."
        },
        "patientId": {
          "type": "string",
          "description": "Associated patient ID."
        },
        "systolic": {
          "type": "number",
          "description": "Systolic blood pressure (mmHg)."
        },
        "diastolic": {
          "type": "number",
          "description": "Diastolic blood pressure (mmHg)."
        },
        "sugar": {
          "type": "number",
          "description": "Blood glucose level."
        },
        "sugarType": {
          "type": "string",
          "description": "Type of sugar test (Fasting / Post-prandial / HbA1c)."
        },
        "temperature": {
          "type": "number",
          "description": "Body temperature in Fahrenheit."
        },
        "heartRate": {
          "type": "number",
          "description": "Heart rate in bpm."
        },
        "consultationNeeded": {
          "type": "boolean",
          "description": "Whether immediate doctor consultation is flagged."
        },
        "aiAssessment": {
          "type": "string",
          "description": "Detailed AI clinical summary generated by Gemini."
        },
        "createdByPhone": {
          "type": "string",
          "description": "Phone number of caregiver who added it."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "patientId", "systolic", "diastolic", "sugar", "sugarType", "temperature", "heartRate", "consultationNeeded", "createdByPhone", "createdAt"]
    },
    "MedicationSchedule": {
      "title": "MedicationSchedule",
      "description": "Daily medication schedule defined for the patient.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of schedule."
        },
        "patientId": {
          "type": "string",
          "description": "Associated patient ID."
        },
        "name": {
          "type": "string",
          "description": "Name of the medicine."
        },
        "dosage": {
          "type": "string",
          "description": "Dosage representation, e.g. 1 Tablet."
        },
        "time": {
          "type": "string",
          "description": "Scheduled local time of dosage e.g. 08:30."
        },
        "instructions": {
          "type": "string",
          "description": "Consumption instructions (e.g. before meals)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "patientId", "name", "dosage", "time", "createdAt"]
    },
    "DosageRecord": {
      "title": "DosageRecord",
      "description": "Historical log of medicine taken or missed, marked by caregivers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID."
        },
        "patientId": {
          "type": "string",
          "description": "Associated patient ID."
        },
        "medicationId": {
          "type": "string",
          "description": "Reference to MedicationSchedule ID."
        },
        "medicationName": {
          "type": "string",
          "description": "Copied medicine name."
        },
        "dosage": {
          "type": "string",
          "description": "Medicine quantity."
        },
        "scheduledTime": {
          "type": "string",
          "description": "Target scheduled time."
        },
        "dateStr": {
          "type": "string",
          "description": "Target date string e.g. 2026-05-29."
        },
        "status": {
          "type": "string",
          "description": "Administered status: given | missed."
        },
        "markedByPhone": {
          "type": "string",
          "description": "Phone number of person who completed tracking."
        },
        "markedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Interaction timestamp."
        }
      },
      "required": ["id", "patientId", "medicationId", "medicationName", "dosage", "scheduledTime", "dateStr", "status", "markedByPhone", "markedAt"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient profiles."
    },
    "/patients/{patientId}/labReports/{reportId}": {
      "schema": "LabReport",
      "description": "Lab report logs."
    },
    "/patients/{patientId}/medicationSchedules/{scheduleId}": {
      "schema": "MedicationSchedule",
      "description": "Schedules of daily medicines."
    },
    "/patients/{patientId}/dosageRecords/{recordId}": {
      "schema": "DosageRecord",
      "description": "Actual record logs of administration."
    }
  }
}
